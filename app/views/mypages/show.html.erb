<%= render "shared/flash_message" %>

<div class="container mx-auto px-4 py-6 max-w-md">
  <h1 class="text-2xl font-bold text-center text-app-primary mb-6">Mypage</h1>

  <div class="bg-white rounded-2xl border border-app-card overflow-hidden shadow-sm">
    <ul class="divide-y divide-gray-100">
      <li>
        <%= link_to profile_path, class: "flex items-center justify-between px-6 py-4 hover:bg-app-main/20 text-app-dark font-medium transition" do %>
          <span>ユーザー情報</span>
          <svg class="w-4 h-4 text-app-dark/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>
      </li>
    </ul>
  </div>
</div>
