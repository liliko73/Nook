<% height = local_assigns[:height] || 32 %>
<% text_color = local_assigns[:text_color] || "#904719" %>

<div class="flex items-center gap-2 inline-flex select-none">
  <svg height="<%= height %>" viewBox="0 0 160 50" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- ひとつのローテーブル（テーマ） -->
    <ellipse cx="20" cy="31" rx="14" ry="4" fill="#efe4cc" stroke="#904719" stroke-width="1.5" />
    <!-- テーブルの脚 -->
    <line x1="10" y1="33" x2="8" y2="38" stroke="#904719" stroke-width="1.5" stroke-linecap="round" />
    <line x1="30" y1="33" x2="32" y2="38" stroke="#904719" stroke-width="1.5" stroke-linecap="round" />
    <!-- 横並びで同じ高さに座る3つの言葉・湯気 -->
    <circle cx="11" cy="20" r="3.5" fill="#904719" />
    <circle cx="20" cy="17" r="4.5" fill="#05435f" />
    <circle cx="29" cy="20" r="3.5" fill="#904719" />
    <!-- ゆるやかな湯気ライン -->
    <path d="M 11 25 C 11 23 12 23 12 21" stroke="#904719" stroke-width="1.2" stroke-linecap="round" fill="none" />
    <path d="M 20 24 C 20 22 21 22 21 20" stroke="#05435f" stroke-width="1.2" stroke-linecap="round" fill="none" />
    <path d="M 29 25 C 29 23 28 23 28 21" stroke="#904719" stroke-width="1.2" stroke-linecap="round" fill="none" />
    <!-- テキスト -->
    <text x="40" y="34" fill="<%= text_color %>" font-family="'M PLUS Rounded 1c', sans-serif" font-weight="800" font-size="22" letter-spacing="0.5">Lounge</text>
  </svg>
</div>
