<%= render "shared/flash_message" %>

<header>
  <!-- ロゴ（クリックでトップページへ戻るリンク） -->
  <div class="logo">
    <%= link_to 'ロゴ', root_path %>
  </div>

  <!-- ナビゲーション（ログアウトボタン） -->
  <nav>
    <%= button_to 'ログアウト', destroy_user_session_path, method: :delete %>
  </nav>
</header>

<div class="container mx-auto px-4 py-8 max-w-lg">
  <h1 class="text-2xl font-bold mb-6 text-center">ユーザー情報</h1>

  <div class="bg-white shadow rounded-lg p-6 space-y-4">
    <div>
      <span class="text-gray-500 text-sm block">メールアドレス</span>
      <p class="font-medium"><%= @user.email %></p>
    </div>

    <div>
      <span class="text-gray-500 text-sm block">ニックネーム</span>
      <p class="font-medium"><%= @user.username %></p>
    </div>

    <div>
      <span class="text-gray-500 text-sm block">ひとこと</span>
      <p class="font-medium"><%= @user.self_introduction %></p>
    </div>

    <div>
      <span class="text-gray-500 text-sm block">あなたの生年月日</span>
      <p class="font-medium"><%= "#{@user.birthday_year}年 #{@user.birthday_month}月 #{@user.birthday_date}日" %></p>
    </div>

    <div>
      <span class="text-gray-500 text-sm block">あなたの性別</span>
      <p class="font-medium"><%= I18n.t("enums.user.gender.#{@user.gender}", default: @user.gender) %></p>
    </div>

    <div>
      <span class="text-gray-500 text-sm block">居住地</span>
      <p class="font-medium"><%= @user.prefecture.presence || "未設定" %></p>
    </div>

    <!-- お子様情報表示例 -->
    <div class="mt-6 border-t pt-4">
      <h2 class="text-md font-bold text-gray-800 mb-2">お子様の情報</h2>
      <% if @user.children.any? %>
        <ul class="space-y-2">
          <% @user.children.each_with_index do |child, i| %>
            <li class="text-sm text-gray-700 bg-gray-50 p-3 rounded border">
              <span class="font-semibold">お子様 <%= i + 1 %>:</span>
              <%= child.birthday_year %>年 <%= child.birthday_month %>月 <%= child.birthday_date %>日生まれ
              （<%= I18n.t("enums.child.gender.#{child.gender}") %>）
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="pt-4 text-center">
      <%= link_to "修正する", edit_profile_path, class: "btn btn-primary w-full py-2 px-4 rounded" %>
    </div>
  </div>
</div>
