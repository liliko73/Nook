<%= render "shared/flash_message" %>

<div class="container mx-auto px-4 py-8 max-w-md">
  <h1 class="text-2xl font-bold mb-6 text-center text-gray-800">ユーザー情報</h1>

  <div class="bg-white rounded-2xl border border-app-card p-6 shadow-sm space-y-5">
    <!-- アイコン画像ダミーエリア -->
    <div class="user-avatar-default" style="width: 80px; height: 80px; border-radius: 50%; background-color: #E2E8F0; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
      <div class="w-20 h-20 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-2">
        <svg class="w-12 h-12 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
      </div>
    </div>
    
    <div>
      <span class="text-xs text-gray-500 block font-medium">メールアドレス</span>
      <p class="text-sm font-medium text-app-dark mt-1"><%= @user.email %></p>
    </div>

    <div>
      <span class="text-xs text-gray-500 block font-medium">ニックネーム</span>
      <p class="text-sm font-medium text-app-dark mt-1"><%= @user.username %></p>
    </div>

    <div>
      <span class="text-xs text-gray-500 block font-medium">ひとこと</span>
      <p class="text-sm font-medium text-app-dark mt-1"><%= @user.self_introduction %></p>
    </div>

    <div>
      <span class="text-xs text-gray-500 block font-medium">あなたの生年月日</span>
      <p class="text-sm font-medium text-app-dark mt-1"><%= "#{@user.birthday_year}年 #{@user.birthday_month}月 #{@user.birthday_date}日" %></p>
    </div>

    <div>
      <span class="text-xs text-gray-500 block font-medium">あなたの性別</span>
      <p class="text-sm font-medium text-app-dark mt-1"><%= I18n.t("enums.user.gender.#{@user.gender}", default: @user.gender) %></p>
    </div>

    <div>
      <span class="text-xs text-gray-500 block font-medium">居住地</span>
      <p class="text-sm font-medium text-app-dark mt-1"><%= @user.prefecture.presence || "未設定" %></p>
    </div>

    <!-- お子様情報表示例 -->
    <div class="border-t border-gray-100 pt-4">
      <span class="text-xs text-gray-500 block font-medium mb-2">お子様の情報</h2>
      <% if @user.children.any? %>
        <div class="space-y-2">
          <% @user.children.each_with_index do |child, i| %>
            <div class="bg-app-main/20 p-3 rounded-lg border border-app-card/40 text-xs text-app-dark">
              <p class="font-semibold text-gray-800 mb-1">お子様 <%= i + 1 %>:</p>
              <p>生年月日：<%= child.birthday_year %>年 <%= child.birthday_month %>月 <%= child.birthday_date %>日</p>
              <p>性別：<%= child.gender.present? ? I18n.t("enums.child.gender.#{child.gender}", default: child.gender) : "未設定" %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="pt-4">
      <%= link_to "修正する", edit_profile_path, class: "block w-full text-center py-2 px-4 rounded-xl font-bold text-white bg-app-primary hover:opacity-90 transition shadow-sm" %>
    </div>
  </div>
</div>
