<div class="min-h-screen flex flex-col justify-center items-center py-10 px-4 sm:px-6 lg:px-8">
  <div class="max-w-lg w-full bg-white p-8 rounded-2xl shadow-md border border-gray-100">

    <!-- タイトル ＆ 説明文 -->
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold text-gray-800 mb-2">登録内容の確認</h2>
      <p class="text-xs text-gray-600 leading-relaxed">
        以下の内容で登録します。<br>
        修正したい箇所があれば、下の戻るボタンから戻ってください。<br>
        問題なければ仮登録メール送信を押してください。
      </p>

      <!-- アイコン画像エリア -->
      <div class="w-20 h-20 rounded-full bg-slate-100 flex items-center justify-center mx-auto mt-4">
        <svg class="w-12 h-12 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
         <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), method: :post) do |f| %>

      <!-- 確認項目エリア -->
      
      <!-- メールアドレス -->
      <div class="bg-gray-50 p-3 rounded-lg">
        <span class="block text-xs font-bold text-gray-500 mb-1">メールアドレス</span>
        <p class="text-sm text-gray-800 font-medium"><%= resource.email %></p>
        <%= f.hidden_field :email %>
      </div>

      <!-- パスワード -->
      <div class="bg-gray-50 p-3 rounded-lg">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-bold text-gray-500">パスワード</span>
          <span class="text-[10px] text-gray-400">（プライバシー保護のため表示していません）</span>
        </div>
        <p class="text-sm text-gray-800 font-medium">※※※※※※※※</p>
        <%= f.hidden_field :password %>
        <%= f.hidden_field :password_confirmation %>
      </div>

      <!-- ニックネーム -->
      <div class="bg-gray-50 p-3 rounded-lg">
        <span class="block text-xs font-bold text-gray-500 mb-1">ニックネーム</span>
        <p class="text-sm text-gray-800 font-medium"><%= resource.username %></p>
        <%= f.hidden_field :username %>
      </div>

      <!-- ひとこと -->
      <div class="bg-gray-50 p-3 rounded-lg">
        <span class="block text-xs font-bold text-gray-500 mb-1">ひとこと</span>
        <p class="text-sm text-gray-800 font-medium"><%= resource.self_introduction %></p>
        <%= f.hidden_field :self_introduction %>
      </div>

      <!-- あなたの生年月日 -->
      <div class="bg-gray-50 p-3 rounded-lg">
        <span class="block text-xs font-bold text-gray-500 mb-1">あなたの生年月日</span>
        <p class="text-sm text-gray-800 font-medium"><%= "#{resource.birthday_year}年#{resource.birthday_month}月#{resource.birthday_date}日" %></p>
        <%= f.hidden_field :birthday_year %>
        <%= f.hidden_field :birthday_month %>
        <%= f.hidden_field :birthday_date %>
      </div>

      <!-- あなたの性別 -->
      <div class="bg-gray-50 p-3 rounded-lg">
        <span class="block text-xs font-bold text-gray-500 mb-1">あなたの性別</span>
        <p class="text-sm text-gray-800 font-medium">
          <%= I18n.t("enums.user.gender.#{resource.gender}", default: resource.gender) %>
        </p>
        <%= f.hidden_field :gender %>
      </div>

      <!-- 居住地 -->
      <div class="bg-gray-50 p-3 rounded-lg">
        <span class="block text-xs font-bold text-gray-500 mb-1">居住地</span>
        <p class="text-sm text-gray-800 font-medium"><%= resource.prefecture %></p>
        <%= f.hidden_field :prefecture %>
      </div>

      <!-- お子様情報（入力された人数分だけループして動的に表示） -->
      <% resource.children.each_with_index do |child, index| %>
      <%# 生年月日や性別の入力があるお子様だけを表示 %>
        <% if child.birthday_year.present? || child.gender.present? %>
          <%= f.fields_for :children, child do |c| %>
            <% suffix = index > 0 ? "（#{index + 1}人目）" : "" %>

            <div class="bg-gray-50 p-3 rounded-lg">
              <span class="block text-xs font-bold text-gray-500 mb-1">お子様の生年月日<%= suffix %></span>
              <p><%= "#{child.birthday_year}年#{child.birthday_month}月#{child.birthday_date}日" %></p>
              <%= c.hidden_field :birthday_year %>
              <%= c.hidden_field :birthday_month %>
              <%= c.hidden_field :birthday_date %>
            </div>
        

            <div class="bg-gray-50 p-3 rounded-lg">
              <span class="block text-xs font-bold text-gray-500 mb-1">お子様の性別<%= suffix %></span>
              <p class="text-sm text-gray-800 font-medium">
                <%= I18n.t("enums.child.gender.#{child.gender}", default: child.gender) %>
              </p>
              <%= c.hidden_field :gender %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <!-- ボタンエリア -->
      <div class="space-y-4 mt-8">
        <!-- 戻るボタン（入力画面へ） -->
        <button type="submit" name="back" value="true"class="w-full py-3 px-4 border border-gray-300 rounded-xl text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition block text-center cursor-pointer shadow-sm">
          戻る
        </button>

        <!-- 仮登録メール送信ボタン -->
        <%= f.submit "仮登録メールを送信する", class: "w-full py-3 px-4 bg-amber-800 hover:bg-amber-900 text-white font-bold rounded-xl shadow-md transition duration-150 cursor-pointer text-center block" %>
      </div>

    <% end %>
  
  </div>
</div>