<%= render "shared/flash_message" %>

<h2>ログイン</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <!-- メールアドレス -->
  <div class="field">
    <%= f.label :email, "メールアドレス" %>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
  </div>

  <!-- パスワード -->
  <div class="field">
    <%= f.label :password, "パスワード" %>
    <p><%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
  </div>

  <!-- ログインボタン -->
  <div class="actions">
    <%= f.submit "ログイン", class: "btn btn-primary" %>
  </div>
<% end %>

  <!-- ユーザー登録ボタン（画面移動） -->
  <div class="actions">
    <%= link_to "ユーザー登録", new_registration_path(resource_name), class: "btn btn-secondary" %>
  </div>

    <%# MVPリリース後に実装 %>
    <%# link_to "パスワードをお忘れの方", new_password_path(resource_name), class: "btn btn-secondary" %>
  </div>
</div>

<%# render "devise/shared/links" %>
