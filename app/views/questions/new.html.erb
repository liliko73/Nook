<%= render "shared/flash_message" %>

<div class="container mx-auto px-4 py-8 max-w-2xl">
  <!-- 戻るリンク -->
  <div class="mb-4">
    <%= link_to '一覧に戻る', questions_path, class: "text-sm text-gray-700 font-medium transition" %>
  </div>

  <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100">
    <!-- Askロゴ ＆ ページタイトル -->
    <div class="text-center mb-6">
      <div class="mb-2">
        <%= render 'shared/ask_logo', height: 60 %>
      </div>
      <h1 class="text-lg font-bold text-grey-700">質問を投稿する</h1>
    </div>

    <%= form_with model: @question, local: true do |f| %>
      <% if @question.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl mb-6 text-sm">
          <ul class="list-disc pl-5 space-y-1">
            <% @question.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- タイトル入力フォーム -->
      <div class="mb-5">
        <%= f.label :title, "タイトル", class: "block text-gray-700 font-bold mb-2 text-sm" %>
        <%= f.text_field :title, class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#904719] focus:border-transparent", placeholder: "例：離乳食の進め方について" %>
      </div>

      <!-- 本文入力フォーム -->
      <div class="mb-6">
        <%= f.label :body, "本文", class: "block text-gray-700 font-bold mb-2 text-sm" %>
        <%= f.text_area :body, rows: 6, class: "w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#904719] focus:border-transparent", placeholder: "質問の具体的な内容を書いてください" %>
      </div>

      <!-- 投稿ボタン -->
      <div class="text-center">
        <%= f.submit "投稿する", class: "bg-[#904719] hover:bg-[#783a13] text-white font-bold py-2.5 px-8 rounded-full shadow-sm transition duration-150 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>