<%= render "shared/flash_message" %>

<header>
  <!-- ロゴ（クリックでトップページへ戻るリンク） -->
  <div class="logo">
    <%= link_to 'ロゴ', root_path %>
  </div>

  <!-- ナビゲーション（ログアウトボタン） -->
  <nav>
    <%= button_to 'ログアウト', destroy_user_session_path, method: :delete %>
  </nav>
</header>

<div class="container mx-auto px-4 py-6 max-w-2xl">
  <h1 class="text-2xl font-bold mb-6">Ask</h1>

  <!-- タブ切り替えボタン -->
  <div class="flex border-b border-gray-300 mb-6">
    <!-- みんなのAsk -->
    <%= link_to 'みんなのAsk',
                questions_path,
                class: "px-4 py-2 text-sm font-semibold #{'border-b-2 border-blue-500 text-blue-600' unless params[:tab] == 'mine'} #{'text-gray-500 hover:text-gray-700' if params[:tab] == 'mine'}" %>

    <!-- あなたのAsk -->
    <%= link_to 'あなたのAsk',
                questions_path(tab: 'mine'),
                class: "px-4 py-2 text-sm font-semibold #{'border-b-2 border-blue-500 text-blue-600' if params[:tab] == 'mine'} #{'text-gray-500 hover:text-gray-700' unless params[:tab] == 'mine'}" %>
  </div>

  <!-- 「あなたのAsk」タブの時のみ表示する「質問を投稿する」ボタン -->
  <% if params[:tab] == 'mine' %>
    <div class="mb-6 text-center">
      <%= link_to '質問を投稿する', new_question_path, class: "inline-block bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-6 rounded-full shadow" %>
    </div>
  <% end %>

  <!-- 質問一覧 -->
  <div class="space-y-4">
    <% if @questions.present? %>
      <% @questions.each do |question| %>
        <div class="bg-white p-4 rounded-lg shadow border border-gray-100">
          <div class="flex justify-between items-start">
            <!-- タイトル（リンクあり） -->
            <h2 class="text-lg font-bold text-blue-600">
              <%= link_to question.title, question_path(question), class: "hover:underline" %>
            </h2>
            <!-- 投稿日（リンクなし） -->
            <span class="text-xs text-gray-400"><%= l(question.created_at, format: :short) %></span>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center text-gray-500 py-8">
        <%= params[:tab] == 'mine' ? 'あなたが投稿した質問はありません。質問を投稿してみましょう！' : '投稿された質問はありません。' %>
      </p>
    <% end %>
  </div>
  </div>
