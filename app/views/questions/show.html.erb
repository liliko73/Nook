<%= render "shared/flash_message" %>

<header>
  <!-- ロゴ（クリックでトップページへ戻るリンク） -->
  <div class="logo">
    <%= link_to 'ロゴ', root_path %>
  </div>

  <!-- ナビゲーション（ログアウトボタン） -->
  <nav>
    <%= button_to 'ログアウト', destroy_user_session_path, method: :delete %>
  </nav>
</header>

<div class="container mx-auto px-4 py-6 max-w-2xl">
  <div class="mb-4">
    <%= link_to '一覧に戻る', questions_path, class: "text-sm text-gray-500 hover:underline" %>
  </div>

  <div class="bg-white p-6 rounded-lg shadow-sm border">
    <div class="flex justify-between items-center mb-4 border-b pb-3">
      <h1 class="text-xl font-bold text-gray-800"><%= @question.title %></h1>
      <span class="text-xs text-gray-400"><%= l(@question.created_at, format: :short) %></span>
    </div>

    <div class="text-gray-700 whitespace-pre-wrap">
      <%= @question.body %>
    </div>
  </div>

  <!-- 回答投稿フォーム -->
  <%# 質問投稿者以外のユーザーにのみ回答フォームを表示 %>
  <% unless @question.user == current_user %>
    <div class="mt-8">
      <h3 class="text-lg font-bold mb-4">回答する</h3>
      <%= form_with(model: [@question, @answer], local: true) do |f| %>
        <%= render 'shared/error_messages', object: f.object if lookup_context.template_exists?('shared/_error_messages') %>
    
        <div class="mb-4">
          <%= f.text_area :body, rows: 4, class: 'w-full p-2 border rounded', placeholder: '回答を入力してください（相手を気遣う思いやりのある言葉遣いを心がけましょう）' %>
        </div>

        <%= f.submit '回答を投稿する', class: 'px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700' %>
      <% end %>
    </div>
  <% end %>

  <hr class="my-8">

  <!-- 回答一覧 -->
  <div class="mt-8">
    <h3 class="text-lg font-bold mb-4">みんなの回答（<%= @answers.count %>件）</h3>
  
    <% if @answers.present? %>
      <div class="space-y-4">
        <% @answers.each do |answer| %>
          <div class="p-4 border rounded bg-white shadow-sm"id="answer-<%= answer.id %>">
            <!-- 親回答ヘッダー・本文 -->
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold text-gray-700"><%= answer.user.username %></span>
              <span class="text-sm text-gray-500"><%= l answer.created_at, format: :short %></span>
            </div>
            <p class="text-gray-800 whitespace-pre-wrap"><%= answer.body %></p>

            <!-- 返信一覧（一段下げて表示） -->
            <% if answer.replies.present? %>
              <div class="ml-4 pl-4 border-l-2 border-gray-200 space-y-3 mb-4">
                <% answer.replies.each do |reply| %>
                  <div class="bg-gray-50 p-3 rounded" id="answer-<%= reply.id %>">
                    <div class="flex items-center justify-between mb-1">
                      <span class="font-bold text-sm text-gray-700"><%= reply.user.username %></span>
                      <span class="text-xs text-gray-400"><%= l reply.created_at, format: :short %></span>
                    </div>
                    <p class="text-sm text-gray-800 whitespace-pre-wrap"><%= reply.body %></p>
                  </div>
                <% end %>
              </div>
            <% end %>

            <!-- 各回答への返信フォーム -->
            <div class="ml-4 pt-3 border-t border-gray-100">
              <%# エラーが発生した対象の返信フォームであれば @answer を使い、それ以外は新規の build を使う %>
              <% reply_target = (@answer&.parent_id == answer.id) ? @answer : @question.answers.build %>

              <%= form_with(model: [@question, reply_target], local: true) do |f| %>
                <%= render 'shared/error_messages', object: f.object if lookup_context.template_exists?('shared/_error_messages') %>
                <%= f.hidden_field :parent_id, value: answer.id %>
                
                <div class="space-y-2">
                  <%= f.text_area :body, rows: 3, class: 'w-full p-2 border rounded text-sm focus:outline-none focus:ring-1 focus:ring-blue-500', placeholder: 'この回答に返信する...' %>
                  <div class="flex justify-end">
                    <%= f.submit '返信', class: 'px-3 py-1 bg-gray-600 text-white text-sm rounded hover:bg-gray-700' %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500">まだ回答はありません。最初の回答を投稿してみましょう！</p>
    <% end %>
  </div>
</div>
