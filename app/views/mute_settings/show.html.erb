<%= render "shared/flash_message" %>

<div class="container mx-auto px-4 py-6 max-w-md space-y-4">
  <div class="flex items-center mb-2">
    <%= link_to settings_mypage_path, class: "text-xs text-app-dark/60 flex items-center gap-1" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <span>設定に戻る</span>
    <% end %>
  </div>

  <h1 class="text-xl font-bold text-center text-app-dark">ミュート設定</h1>

  <div class="bg-white rounded-2xl border border-app-card p-4 shadow-sm space-y-3">
    <h2 class="text-xs font-bold text-app-dark/70 border-b border-gray-100 pb-2">ミュートしているユーザー</h2>

    <% if @muted_users.present? %>
      <ul class="divide-y divide-gray-100">
        <% @muted_users.each do |user| %>
          <li class="py-3 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 min-w-0">
              <div class="w-7 h-7 rounded-full bg-gray-200 shrink-0 flex items-center justify-center text-gray-400">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              </div>
              <span class="text-xs font-bold text-app-dark truncate"><%= user.username %></span>
            </div>

            <%= button_to user_mute_path(user),
                  method: :delete,
                  onclick: "return confirm('#{user.username} さんのミュートを解除しますか？');",
                  class: "px-3 py-1 bg-gray-100 hover:bg-gray-200 text-app-dark text-xs font-bold rounded-xl transition border-0 cursor-pointer shrink-0" do %>
              解除する
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-xs text-app-dark/50 text-center py-4">ミュートしているユーザーはいません。</p>
    <% end %>
  </div>
</div>
