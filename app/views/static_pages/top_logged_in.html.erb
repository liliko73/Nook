<%= render "shared/flash_message" %>

<header>
  <!-- ロゴ（クリックでトップページへ戻るリンク） -->
  <div class="logo">
    <%= link_to 'ロゴ', root_path %>
  </div>

  <!-- ナビゲーション（ログアウトボタン） -->
  <nav>
    <%= button_to 'ログアウト', destroy_user_session_path, method: :delete %>
  </nav>
</header>

<div class="top-logged-in-container">
  <!-- Loungeエリア（今週のテーマ） -->
  <section class="lounge-section">
    <h2>Loungeロゴ</h2>
    <p>今週のトークテーマ</p>
    
    <!-- Lounge詳細ページ（テーマ詳細）へのリンク -->
    <div class="theme-card">
      <% if @theme %>
        <%= link_to @theme.title, theme_path(@theme), class: "font-bold text-lg text-gray-800 hover:underline" %>
      <% else %>
        <p class="text-gray-500">現在表示できるテーマはありません</p>
      <% end %>
    </div>

  <%# MVPリリース時はテーマ募集機能を非表示 %>
  <div>
    <%# link_to 'テーマ募集中！', '#', class: 'btn-theme-recruit' %>
  </div>
  
  </section>

  <!-- Askエリア（最新の質問） -->
  <section class="ask-section">
    <h2>Askロゴ</h2>
    <p>新しく投稿された質問</p>
    
    <!-- 最新の質問リスト -->
    <div class="question-list">
      <ul>
        <% if @questions.present? %>
          <% @questions.each do |question| %>
            <li>
              <%= link_to question.title, question_path(question), class: "text-blue-600 hover:underline" %>
            </li>
          <% end %>
        <% else %>
          <li class="text-gray-500">投稿された質問はありません。</li>
        <% end %>
      </ul>
    </div>

    <!-- Ask一覧ページへのリンク -->
    <div>
      <%= link_to '質問一覧を見る', questions_path, class: 'btn-ask-index' %>
    </div>
  </section>

  <!-- MyPageへのリンク -->
  <footer class="mypage-section">
    <%= link_to 'Mypage', mypage_path, class: 'btn-mypage' %>
  </footer>
</div>