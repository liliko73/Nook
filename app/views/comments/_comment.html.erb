<div id="<%= dom_id(comment) %>" class="p-4 border-b">
  <!-- 投稿者名や本文など -->

<% if comment.user == current_user %>
  <%= link_to comment_path(comment),
        data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' },
        class: 'text-red-500 hover:text-red-700 ml-2' do %>
    <!-- アイコン（FontAwesomeやHeroicons等を使用している場合）やテキスト -->
    <i class="fa-solid fa-trash-can"></i> 削除
  <% end %>
<% end %>