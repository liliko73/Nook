<%= render "shared/flash_message" %>

<header>
  <!-- ロゴ（クリックでトップページへ戻るリンク） -->
  <div class="logo">
    <%= link_to 'ロゴ', root_path %>
  </div>

  <!-- ナビゲーション（ログアウトボタン） -->
  <nav>
    <%= button_to 'ログアウト', destroy_user_session_path, method: :delete %>
  </nav>
</header>

<div class="container mx-auto px-4 py-6 max-w-2xl">
  <!-- 1. テーマ表示エリア -->
  <section class="theme-section mb-6">
    <h2 class="text-xs font-bold text-gray-500 mb-1">今週のトークテーマ</h2>
    <h1 class="text-2xl font-bold text-gray-900 mb-3"><%= @theme.title %></h1>
    <p class="text-sm text-gray-700 whitespace-pre-wrap leading-relaxed"><%= @theme.body %></p>
  </section>

  <!-- 2. コメント投稿フォーム -->
  <div class="comment-form">
    <%= form_with(model: [@theme, @comment], local: true) do |f| %>
      <%= render 'shared/error_messages', object: f.object %>
      <div class="field">
        <%= f.text_area :body, placeholder: "あなたはどうしてる？", rows: 3 %>
      </div>
      <%= f.submit "コメントする" %>
    <% end %>
  </div>

  <!-- 3. コメント一覧表示 -->
  <div class="comments-list">
    <h3>みんなのコメント</h3>
    <% if @comments.present? %>
      <% @comments.each do |comment| %>
        <div class="comment-item border-b py-4">
          <%# --- 親コメントの表示 --- %>
          <div class="comment-header">
            <span class="user-name"><%= comment.user.username %></span>
            <span class="created-at"><%= l comment.created_at, format: :short %></span>
          </div>
          <div class="comment-body">
            <%= simple_format(h(comment.body)) %>
          </div>

          <%# --- 返信（会話）の開閉エリア --- %>
          <details class="mt-2">
            <summary class="cursor-pointer text-sm text-blue-600 hover:underline">
              💬 返信
            </summary>
            
            <%# 返信一覧と返信フォームのコンテナ %>
            <div class="replies-container pl-4 mt-3 border-l-2 border-gray-200">
              
              <%# 1. 返信が存在する場合のみ一覧を表示（ない場合は何も表示しない） %>
              <% if comment.replies.present? %>
                <% comment.replies.each do |reply| %>
                  <div class="reply-item my-2 p-2 bg-gray-50 rounded">
                    <div class="reply-header text-xs text-gray-600">
                      <span class="font-bold"><%= reply.user.username %></span>
                      <span><%= l reply.created_at, format: :short %></span>
                    </div>
                    <div class="reply-body text-sm mt-1">
                      <%= simple_format(h(reply.body)) %>
                    </div>
                  </div>
                <% end %>
              <% end %>

              <%# 2. 返信入力フォーム（常に表示） %>
              <%= form_with(model: [@theme, Comment.new], local: true, class: "mt-3") do |f| %>
                <%= f.hidden_field :parent_id, value: comment.id %>
                <div class="mb-2">
                  <%= f.text_area :body, rows: 2, class: "w-full p-2 border rounded text-sm", placeholder: "返信を入力してください" %>
                </div>
                <%= f.submit "返信する", class: "px-3 py-1 bg-blue-500 text-white rounded text-sm hover:bg-blue-600" %>
              <% end %>

            </div>        
          </details>
        </div>
      <% end %>
    <% else %>
      <p>まだコメントはありません。最初のコメントを投稿してみましょう！</p>
    <% end %>
  </div>
</div>
